     fn generate_precedence_binary_op(
         &mut self,
         op: &BinaryOp,
         operator: &str,
         infix_operator: InfixOperator,
     ) -> Result<()> {
+        if self.config.dialect == Some(DialectType::SQLite)
+            && matches!(operator, "+" | "-")
+            && Self::is_current_time(&op.left)
+        {
+            if let Expression::Interval(interval) = &op.right {
+                if let Some((amount, unit)) = self.sqlite_time_modifier(interval) {
+                    self.write(&format!("datetime('now', '{operator}{amount} {unit}')"));
+                    return Ok(());
+                }
+            }
+        }
         self.generate_binary_op_with_precedence(op, operator, Some(infix_operator))
     }
 
