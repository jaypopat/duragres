+    fn is_current_time(expr: &Expression) -> bool {
+        matches!(expr, Expression::CurrentTimestamp(ts) if ts.precision.is_none() && !ts.sysdate)
+            || matches!(expr, Expression::Function(f) if !f.quoted && f.qualified_name.len() <= 1
+                && f.args.is_empty() && f.name.eq_ignore_ascii_case("CURRENT_TIMESTAMP"))
+    }
+
+    fn sqlite_time_modifier(&self, interval: &Interval) -> Option<(String, String)> {
+        let Expression::Literal(literal) = interval.this.as_ref()? else {
+            return None;
+        };
+        let (Literal::String(value) | Literal::Number(value)) = literal.as_ref() else {
+            return None;
+        };
+        let (amount, unit) = match &interval.unit {
+            Some(IntervalUnitSpec::Simple { unit, .. }) => {
+                (value.trim(), self.interval_unit_str(unit, false))
+            }
+            None => {
+                let mut parts = value.split_whitespace();
+                let pair = (parts.next()?, parts.next()?);
+                if parts.next().is_some() {
+                    return None;
+                }
+                pair
+            }
+            _ => return None,
+        };
+        let unit = unit.to_ascii_lowercase();
+        let unit = unit.strip_suffix('s').unwrap_or(&unit);
+        if amount.is_empty()
+            || !amount.bytes().all(|c| c.is_ascii_digit())
+            || !matches!(
+                unit,
+                "second" | "minute" | "hour" | "day" | "month" | "year"
+            )
+        {
+            return None;
+        }
+        Some((amount.to_owned(), unit.to_owned()))
+    }
