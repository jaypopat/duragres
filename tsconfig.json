{
  // The Worker. Env and runtime types are generated into .cloudflare/types by wrangler.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "types": [],
    // The generated types import "cf/config", which the cf CLI re-exports from @cloudflare/config.
    "paths": { "cf/config": ["./node_modules/@cloudflare/config/dist/public.d.mts"] },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", ".cloudflare/types"]
}
